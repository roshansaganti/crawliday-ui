# Local development environment template.
# Copy this file to .env and replace the calendar values with the URLs for your calendars.
# npm run serve also requires the Doppler CLI configured for this project (see doppler.yaml).
# Values prefixed with VUE_APP_ are included in the browser bundle; do not put secrets here.

# Base URL of the Crawliday API.
VUE_APP_API_BASE_URL="your-api-base-url-here"

# Full calendar subscription/add URL and full iframe embed URL.
VUE_APP_CHRISTMAS_ICAL="your-calendar-ical-url-here"
VUE_APP_CHRISTMAS_EMBED="your-calendar-embed-url-here"
VUE_APP_HALLOWEEN_ICAL="your-calendar-ical-url-here"
VUE_APP_HALLOWEEN_EMBED="your-calendar-embed-url-here"